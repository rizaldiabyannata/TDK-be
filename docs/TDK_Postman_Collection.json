{
  "info": {
    "name": "TDK Backend API Collection",
    "description": "Complete API collection for TDK Backend (Express.js + MongoDB + Redis)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.1.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tdk.com\",\n  \"password\": \"Tdk@123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/login",
              "host": ["{{base_url}}"],
              "path": ["user", "login"]
            },
            "description": "Login dengan kredensial admin untuk mendapatkan access token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', response.data.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', response.data.refreshToken);",
                  "    console.log('Token saved successfully');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/refresh-token",
              "host": ["{{base_url}}"],
              "path": ["user", "refresh-token"]
            },
            "description": "Refresh access token menggunakan refresh token"
          }
        },
        {
          "name": "Check Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/user/session",
              "host": ["{{base_url}}"],
              "path": ["user", "session"]
            },
            "description": "Check status session user"
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/user/profile",
              "host": ["{{base_url}}"],
              "path": ["user", "profile"]
            },
            "description": "Get informasi profile user"
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Updated\",\n  \"email\": \"admin@tdk.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/update",
              "host": ["{{base_url}}"],
              "path": ["user", "update"]
            },
            "description": "Update informasi profile user"
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tdk.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/request-password-reset",
              "host": ["{{base_url}}"],
              "path": ["user", "request-password-reset"]
            },
            "description": "Request OTP untuk reset password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tdk.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/reset-password",
              "host": ["{{base_url}}"],
              "path": ["user", "reset-password"]
            },
            "description": "Reset password menggunakan OTP"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/user/logout",
              "host": ["{{base_url}}"],
              "path": ["user", "logout"]
            },
            "description": "Logout dan invalidate token"
          }
        }
      ]
    },
